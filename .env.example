# ============================================================
# 1. LLM - dung cho AGENT tra loi cau hoi va LLM JUDGE cham diem
#    Provider ho tro: gemini | openai | anthropic | openrouter | ollama | custom
# ============================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ============================================================
# 2. EMBEDDING - dung de bien text thanh vector cho ChromaDB
#    HOAN TOAN DOC LAP voi LLM_PROVIDER o tren (co the tron 2 hang khac nhau)
#
#    gemini -> models/gemini-embedding-001      ($0.15/1M, free tier 1500 req/ngay)
#    openai -> text-embedding-3-small           ($0.02/1M, re nhat)
#    minilm -> sentence-transformers/all-MiniLM-L6-v2  (local, mien phi, dung yeu cau de bai)
#
#    Doi provider = doi so chieu vector -> phai xoa data/chroma va chay lai pipeline.
# ============================================================
EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=          # de trong = dung model mac dinh cua provider
# EMBEDDING_DIMENSIONS=768  # chi ap dung cho gemini va openai text-embedding-3-*

# ============================================================
# 3. API KEYS - chi dien key cua provider ban thuc su dung
# ============================================================
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ============================================================
# 4. TUY CHON - dieu khien pipeline chay lai tu dau
# ============================================================
# REFRESH_SOURCE=1     # fetch lai tu Crossref thay vi dung cache trong data/raw/
# REFRESH_TEST_SET=1   # tao lai test set (CANH BAO: lam mat tinh cong bang khi so sanh)
# RUN_RAGAS=1          # bat them bo metrics Ragas (cham hon nhieu)
